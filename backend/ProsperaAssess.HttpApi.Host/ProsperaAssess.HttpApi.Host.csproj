<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>ProsperaAssess.Api</AssemblyName>
    <RootNamespace>ProsperaAssess.Api</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>15b72af6-9673-47c0-87c7-1f4aed351fb2</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="$(EfCoreVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../ProsperaAssess.Application/ProsperaAssess.Application.csproj" />
    <ProjectReference Include="../ProsperaAssess.EntityFrameworkCore/ProsperaAssess.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../ProsperaAssess.HttpApi/ProsperaAssess.HttpApi.csproj" />
    <PackageReference Include="Volo.Abp.BackgroundWorkers" Version="$(AbpVersion)" />
  </ItemGroup>
</Project>